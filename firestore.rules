rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserDataSync(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.dataJson is string && data.dataJson.size() <= 1048576 &&
             data.version is int && data.version >= 1 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/userData/{docId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(docId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'dataJson', 'version', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'dataJson', 'version', 'createdAt', 'updatedAt']) &&
                       isValidUserDataSync(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(docId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserDataSync(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['dataJson', 'version', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(docId);
    }
  }
}
